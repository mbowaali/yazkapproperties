# Vercel Postgres — set automatically when you link a Vercel Postgres DB
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# JWT secret — generate a random string, e.g.: openssl rand -base64 32
JWT_SECRET=

# Admin credentials (used by scripts/create-admin.mjs)
ADMIN_EMAIL=mbowaali@gmail.com
ADMIN_PASSWORD=your_admin_password
